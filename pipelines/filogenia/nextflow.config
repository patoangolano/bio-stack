// bio-stack/filogenia — configuracao.
//
// Roda no WSL (Nextflow nao roda nativo no Windows) com -profile docker, o
// unico perfil de container verificado nesta maquina. O work dir deve ficar
// no home do WSL: /mnt/c e ordens de grandeza mais lento para os milhares de
// arquivos pequenos que o Nextflow cria.

// Os parametros sao declarados, com tipo, no bloco `params` do main.nf (sem o
// tipo o Nextflow 26.04 entrega a linha de comando como String). So o outdir
// fica tambem aqui, porque os relatorios abaixo o usam na hora de ler a config.
params {
    outdir = 'resultados'
}

manifest {
    name            = 'bio-stack/filogenia'
    description     = 'Locos nao alinhados ate arvore de ML, concordancia e arvore de especies, com IQ-TREE 3'
    version         = '1.0.0'
    nextflowVersion = '!>=25.10.0'
    mainScript      = 'main.nf'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Proveniencia padronizada da execucao: Workflow Run RO-Crate na raiz do
// outdir e BioCompute Object em pipeline_info. Complementa, nao substitui, o
// runs/provenance.jsonl que o invólucro grava. O crate so valida (WorkflowHub,
// Zenodo) quando o manifest tiver `license` — o repositorio ainda nao escolheu
// uma, e o nf-prov avisa isso a cada execucao.
plugins {
    id 'nf-prov@1.7.0'
}

prov {
    enabled = true
    formats {
        wrroc {
            file      = "${params.outdir}/ro-crate-metadata.json"
            overwrite = true
        }
        bco {
            file      = "${params.outdir}/pipeline_info/bco.json"
            overwrite = true
        }
    }
}

profiles {
    docker {
        docker.enabled    = true
        // Sem isto o container escreve no work/ como root e o `nextflow clean`
        // do usuario manec nao consegue apagar depois.
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/relatorio_execucao.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    // cpu_model, attempt e workdir: em que maquina, em que tentativa e onde cada
    // tarefa rodou — o que falta saber quando um resultado nao se reproduz. O
    // campo `env` fica de fora de proposito: o repositorio e publico.
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,container,cpus,memory,realtime,%cpu,peak_rss,cpu_model,workdir'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
