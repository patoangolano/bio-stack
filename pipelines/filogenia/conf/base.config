// Recursos por rotulo. O WSL tem 20 nucleos e 15 GB; o teto em
// resourceLimits deixa folga para o Windows e para o daemon do Docker, e faz
// o Nextflow encolher pedidos maiores em vez de falhar.

process {
    cpus   = 1
    memory = 2.GB
    time   = 4.h

    resourceLimits = [cpus: 16, memory: 12.GB, time: 48.h]

    // 130-145: sinais (137 = OOM killer). 125: container que nao subiu (pull
    // que falhou) — o codigo que o executor local com Docker devolve, medido em
    // 2026-10-12. 104 e 175 vem do template nf-core e nao sao falha de
    // container: 175 e do Fusion Snapshots da Seqera (nuvem), 104 o nf-core
    // lista entre falta de memoria; ficam por inocuos. 134 (SIGABRT) fica fora:
    // e aborto deterministico do programa, e repetir so gasta tempo. A nova
    // tentativa so resolve OOM se a memoria
    // crescer — por isso ela multiplica por task.attempt abaixo (contida pelo
    // resourceLimits). O tempo tambem multiplica, mas isso so vale em executor
    // de fila: no executor local (o desta stack), estourar o `time` nao vira
    // exit 140 — o Nextflow 26.04.6 derruba a execucao inteira com
    // "process hasn't exited", sem nova tentativa (medido em 2026-10-11). Por
    // isso os tempos daqui sao folgados.
    errorStrategy = { task.exitStatus in ((130..133) + (135..145) + 104 + 125 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 12.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
}
