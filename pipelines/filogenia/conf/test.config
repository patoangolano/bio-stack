// Perfil de teste: cinco locos simulados com AliSim sobre arvore_verdadeira.nwk
// (assets/test/gerar.sh). loco_E tem tres taxons e deve ser descartado;
// loco_D nao tem o outgroup; loco_C nao tem dois taxons. Roda em poucos minutos.
//
//   nextflow run pipelines/filogenia -profile test,docker --outdir /tmp/filogenia_teste

params {
    input    = "${projectDir}/assets/test/locos"
    outgroup = 'Homo_sapiens'
}

process {
    resourceLimits = [cpus: 4, memory: 8.GB, time: 1.h]

    withName: 'IQTREE_CONCAT' {
        memory = 6.GB
    }
}
