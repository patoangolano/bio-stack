// Argumentos e publicacao por processo.
//
// publishDir em modo copy: o work/ mora no home do WSL e o outdir em /mnt/c;
// symlink atravessando essa fronteira nao abre no Windows.

process {

    withName: 'PREPARA_LOCO' {
        ext.args   = { [params.tipo_seq ? "--tipo ${params.tipo_seq}" : '', "--nome-taxon ${params.nome_taxon}"].findAll { a -> a }.join(' ') }
        publishDir = [path: { "${params.outdir}/01_entrada" }, mode: 'copy', pattern: '*.entrada.{fa,json}']
    }

    withName: 'MAFFT_ALIGN' {
        // L-INS-i e o modo mais preciso do MAFFT; o manual o recomenda ate
        // ~200 sequencias. Acima disso, --auto escolhe uma estrategia escalavel.
        //
        // --threadit 0: o refinamento iterativo multithread do MAFFT nao e
        // deterministico. Medido em 2026-10-11 no loco_B do teste: --thread 8
        // deu 2 alinhamentos distintos em 3 rodadas; com --threadit 0, 1 em 3.
        // A etapa progressiva continua paralela.
        ext.args   = { meta.n_seqs <= 200 ? '--localpair --maxiterate 1000 --threadit 0' : '--auto --threadit 0' }
        ext.prefix = { "${meta.id}" }
        // O rotulo process_high do modulo pede 12 GB, e o executor local reserva
        // o que e pedido: so um MAFFT rodaria por vez nos 15 GB do WSL. L-INS-i
        // de ate 200 sequencias cabe folgado em 2 GB; dobra a cada nova tentativa.
        cpus       = 4
        memory     = { 2.GB * task.attempt }
        publishDir = [path: { "${params.outdir}/02_alinhamento" }, mode: 'copy', pattern: '*.fas']
    }

    withName: 'FAMSA_ALIGN' {
        ext.prefix = { "${meta.id}" }
        publishDir = [path: { "${params.outdir}/02_alinhamento" }, mode: 'copy', pattern: '*.aln']
    }

    withName: 'CLIPKIT' {
        ext.args   = { "--mode ${params.clipkit_modo}" }
        ext.prefix = { "${meta.id}.limpo" }
        publishDir = [path: { "${params.outdir}/03_limpeza" }, mode: 'copy', pattern: '*.limpo.fa{,.log}']
    }

    withName: 'TRIMAL' {
        ext.args   = '-automated1 -fasta'
        ext.prefix = { "${meta.id}.limpo" }
        publishDir = [path: { "${params.outdir}/03_limpeza" }, mode: 'copy', pattern: '*.limpo.fa']
    }

    // -T vem do patch local do modulo (ver modules/nf-core/iqtree/iqtree.diff),
    // que troca o -T AUTO por -T task.cpus. Medido em 2026-10-11 com IQ-TREE
    // 3.1.4 e --seed fixo: -T 1 reproduz o .treefile bit a bit em 3 rodadas;
    // -T 2 mantem topologia, lnL e suportes entre rodadas, mas o comprimento de
    // ramo varia na 8a casa decimal (ate ~5e-8; ordem da soma em ponto
    // flutuante entre threads) e o SH-aLRT difere do -T 1 em ate 1,3 ponto.
    // As arvores de genes ja rodam em paralelo entre locos, entao 1 thread
    // por loco nao custa nada.
    // --abayes entra porque o wASTRAL pondera melhor com o aBayes do IQ-TREE
    // (Zhang & Mirarab 2022, doi:10.1093/molbev/msac215); o rotulo passa a
    // "SH-aLRT/aBayes/UFBoot" e o ASTER_WASTRAL extrai o campo do meio.
    withName: 'IQTREE_GENES' {
        cpus       = 1
        // Arvore de um loco usa centenas de MB; 2 GB deixam ~7 em paralelo nos
        // 15 GB do WSL (com 4 GB eram 3). O modulo repassa isso ao IQ-TREE como
        // -mem. Memoria dobra a cada nova tentativa depois de OOM (137), contida
        // pelo resourceLimits; o tempo tambem, mas so em executor de fila (no
        // local, estourar o tempo derruba a execucao — ver base.config).
        memory     = { 2.GB * task.attempt }
        time       = { 24.h * task.attempt }
        ext.args   = {
            [
                "-m ${params.modelo}",
                params.ufboot ? "-B ${params.ufboot}" : '',
                params.ufboot && params.bnni ? '--bnni' : '',
                params.alrt ? "--alrt ${params.alrt}" : '',
                params.abayes ? '--abayes' : '',
                "--seed ${params.seed}",
                meta.outgroup_presentes ? "-o ${meta.outgroup_presentes}" : '',
                params.tipo_seq ? "-st ${params.tipo_seq}" : '',
            ].findAll { a -> a }.join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [path: { "${params.outdir}/04_arvores_genes" }, mode: 'copy', pattern: '*.{treefile,contree,iqtree,log}']
    }

    // Padrao 1 thread pelo mesmo motivo acima. Supermatriz grande fica lenta:
    // --cpus_concatenado N acelera e troca reproducao bit a bit por reproducao de
    // topologia e lnL (UFBoot/SH-aLRT podem variar 1-2 pontos). Tempo de 24 h,
    // dobrado na nova tentativa: em 1 thread, MFP+MERGE + UFBoot + aBayes numa
    // supermatriz de centenas de locos passa facil das 4 h do padrao.
    withName: 'IQTREE_CONCAT' {
        cpus       = { params.cpus_concatenado }
        memory     = 12.GB
        time       = { 24.h * task.attempt }
        // A memoria ja esta no teto do resourceLimits: repetir depois de um OOM
        // (137) rodaria horas para morrer igual. So repete container que nao
        // subiu (125, pull que falhou — ver base.config).
        errorStrategy = { task.exitStatus == 125 ? 'retry' : 'finish' }
        ext.args   = {
            [
                // Reamostrar locos (GENE/GENESITE) so faz sentido com uma particao
                // por loco: depois do MERGE o IQ-TREE sortearia os blocos JA
                // FUNDIDOS (com tudo fundido em um, GENESITE = SITE). Por isso,
                // com --amostragem_concat, o modelo e escolhido por loco, sem fusao.
                params.modelo == 'MFP' ? (params.amostragem_concat ? '-m MFP' : '-m MFP+MERGE') : "-m ${params.modelo}",
                params.ufboot ? "-B ${params.ufboot}" : '',
                params.ufboot && params.bnni ? '--bnni' : '',
                // So passa --sampling quando pedido: passar a opcao (com qualquer
                // valor) muda a verossimilhanca das particoes no IQ-TREE 3.1.4, e
                // --sampling SITE explicito com --bnni aborta ("Wrong -bsam") — medido.
                params.ufboot && params.amostragem_concat ? "--sampling ${params.amostragem_concat}" : '',
                params.alrt ? "--alrt ${params.alrt}" : '',
                params.abayes ? '--abayes' : '',
                "--seed ${params.seed}",
                meta.outgroup_presentes ? "-o ${meta.outgroup_presentes}" : '',
                params.tipo_seq ? "-st ${params.tipo_seq}" : '',
            ].findAll { a -> a }.join(' ')
        }
        ext.prefix = 'concatenado'
        publishDir = [path: { "${params.outdir}/05_concatenado" }, mode: 'copy', pattern: '*.{treefile,contree,iqtree,log,best_scheme.nex,best_model.nex}']
    }

    withName: 'CONCATENA' {
        publishDir = [path: { "${params.outdir}/05_concatenado" }, mode: 'copy', pattern: '*.{fa,nex,tsv}']
    }

    withName: 'IQTREE_CONCORDANCIA' {
        cpus       = 1
        time       = { 24.h * task.attempt }
        ext.args   = { "--seed ${params.seed}" }
        ext.scfl   = { params.scfl }
        ext.prefix = 'concordancia'
        publishDir = [path: { "${params.outdir}/06_concordancia" }, mode: 'copy', pattern: 'concordancia.*']
    }

    withName: 'ASTER_WASTRAL' {
        cpus       = 2
        ext.args   = { "--seed ${params.seed}" }
        ext.prefix = 'especies'
        publishDir = [path: { "${params.outdir}/07_arvore_especies" }, mode: 'copy', pattern: 'especies.*']
    }

    withName: 'RESUMO' {
        publishDir = [path: { "${params.outdir}" }, mode: 'copy', pattern: '{resumo.tsv,resumo.json,metodos.md}']
    }
}
