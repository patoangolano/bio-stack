{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script 'C:\\Users\\Manec\\bio-stack\\.codex\\hooks\\guard_data.py'",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script 'C:\\Users\\Manec\\bio-stack\\.codex\\hooks\\lint_gate.py'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script 'C:\\Users\\Manec\\bio-stack\\.codex\\hooks\\provenance.py'",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script 'C:\\Users\\Manec\\bio-stack\\.codex\\hooks\\session_context.py'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
