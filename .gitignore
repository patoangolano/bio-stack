# ambiente
.venv/
# venv dos ambientes isolados (envs/<nome>/.venv). O requirements.in de cada
# um E versionado: e ele que reconstroi.
envs/**/.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# segredos — as chaves vivem no ambiente do usuario, nunca em arquivo
.env
.env.*
*.key
.claude/settings.local.json

# dados brutos: grandes demais para git. Use DVC, git-annex ou o storage da
# universidade, e versione apenas o manifesto.
data/raw/**
!data/raw/.gitkeep
data/proc/**
!data/proc/.gitkeep

*.bam
*.bai
*.cram
*.fastq
*.fastq.gz
*.fq.gz
*.sra
*.vcf.gz
*.vcf.gz.tbi
*.h5ad
*.loom

# saidas de analise. O provenance.jsonl E versionado de proposito:
# ele e o caderno de laboratorio e precisa de historico.
runs/nim/**
!runs/nim/.gitkeep
!runs/provenance.jsonl
# logs, .cmd gerados e marcas de restauracao dos scripts de bootstrap/
runs/bootstrap/

# bibliografia: o PDF e dado bruto (direito autoral e tamanho) e fica fora do
# git; o manifesto e o artefato citavel e e versionado. Quem clonar reconstroi
# a biblioteca com `python scripts/biblio/baixar_pdfs.py`.
data/biblio/pdf/**
!data/biblio/manifesto.jsonl

# nextflow
work/
.nextflow/
.nextflow.log*

# sistema
Thumbs.db
.DS_Store
# copias temporarias do Google Drive (a pasta do projeto e sincronizada);
# um `git add .` levaria centenas de MB de lixo para o historico.
.tmp.drive*/

# artefatos de sondagem e indice RAG — grandes, regeneraveis, sem valor de historico
runs/probe-*/**
runs/library/**
!runs/library/.gitkeep
runs/queue.jsonl

# Clones de terceiros que nao sao pacote instalavel (BoneJ_Headless,
# opencap-processing). Nao versionados aqui: sao clones, e o BoneJ_Headless tem
# 415 MB de imagem de exemplo no upstream. Reconstroi: bash vendor/clonar.sh
vendor/*/
!vendor/clonar.sh

# Release do daemon do Claude Science, baixado pelo instalador. 124 MB de
# binario de terceiro, versionado no repositorio deles.
runtime/

# Fatias de genoma e bancos BLAST do teste de reliquia (s24/s25/s26). Sao
# ~9,7 MB regeneraveis por uma chamada de API: os scripts baixam de novo pelo
# accession. O que tem valor de historico sao os TSV de resultado e o JSON de
# resumo, e esses ficam.
runs/atavismo/lncrna/*.fna
runs/atavismo/lncrna/*.faa
runs/atavismo/lncrna/db_*
runs/atavismo/lncrna/*.bed
runs/atavismo/lncrna/*.err
runs/atavismo/lncrna/*.fai

# Mesma regra para o s27 (painel por intervalo): ~101 MB, dos quais 76 MB sao o
# proteoma do jacare que o s27_reciproco.sh baixa sozinho pelo accession. Ficam
# os TSV (indice, sobreviventes, reciproco, produtos) e o s27_resumo.json.
runs/atavismo/painel/*.fna
runs/atavismo/painel/*.faa
runs/atavismo/painel/*.fai
runs/atavismo/painel/db_*
runs/atavismo/painel/proteoma_Amis/

# caches
.ruff_cache/
.pytest_cache/

# rascunho de sessao na raiz — nao faz parte do projeto
*.bak

# saidas grandes e regeneraveis da campanha de atavismo. O que tem valor de
# historico (matriz, TSV do inventario, pesquisa verificada) fica versionado.
runs/atavismo/seqs/**
runs/atavismo/inventario_bruto.json
runs/atavismo/s7_ortologos_ncbi.json
runs/atavismo/*.fa
runs/atavismo/*.fasta
runs/atavismo/evo2_entradas/**
fc.gz

# filogenia (pipelines/filogenia). Fica versionado o que tem valor de historico:
# arvores, alinhamentos, resumo, metodos.md, figuras, executar.sh, versoes.yml,
# parametros.json e a proveniencia do nf-prov (ro-crate-metadata.json, bco.json
# e o nextflow.config resolvido da execucao). Sai a copia da entrada, a
# supermatriz (reconstruivel dos alinhamentos limpos), o log por sitio do
# ClipKIT (maior que o proprio alinhamento), as copias do codigo que o nf-prov
# poe no crate (ja versionado em pipelines/) e os relatorios HTML do Nextflow.
runs/filogenia/*/01_entrada/
runs/filogenia/*/05_concatenado/supermatriz.fa
runs/filogenia/*/03_limpeza/*.log
runs/filogenia/*/main.nf
runs/filogenia/*/README.md
runs/filogenia/*/pipeline_info/*.html
runs/filogenia/*/nextflow_console.log
# Rapinantes (300 locos): uma figura por arvore de gene, em PNG e SVG, sao 600
# arquivos e ~170 MB por execucao. Ficam a arvore de especies e a concatenada;
# as de gene saem de 04_arvores_genes com `filogenia.py desenhar`.
runs/filogenia/*rapinantes*/figuras/*
!runs/filogenia/*rapinantes*/figuras/especies.*
!runs/filogenia/*rapinantes*/figuras/concatenado.*

# Rapinantes: dados de terceiros baixados (AVONET, EltonTraits, ERDA/B10K, Kuhl
# 2021, Prum 2015) nao sao redistribuidos aqui, como data/raw/. O manifesto tem
# URL de origem e md5 de cada arquivo, o que basta para baixar de novo e conferir.
runs/rapinantes/ancestral/downloads/**
!runs/rapinantes/ancestral/downloads/MANIFESTO_downloads.tsv
# Checkpoints binarios do IQ-TREE: so servem para retomar uma execucao.
runs/rapinantes/**/*.ckp.gz

# capturas de navegador deixadas por agentes (Playwright MCP)
.playwright-mcp/

# Repositorios de skills de terceiros, clonados dentro do marketplace local.
# Ficam ali e nao em vendor/ porque o `claude plugin install` recusa uma entrada
# cujo caminho saia do diretorio do marketplace — inclusive por juncao de
# diretorio ("link-traversing entry"). Nao sao versionados aqui: sao clones.
# Reconstrucao: bash .claude/marketplace/plugins/clonar.sh
.claude/marketplace/plugins/*/
!.claude/marketplace/plugins/bio-lsp/
!.claude/marketplace/plugins/clonar.sh
!.claude/marketplace/plugins/extrair_pavel.sh

# Sessao autenticada do daemon do Claude Science, se alguem apontar o cache
# para dentro do projeto. O cookie operon_auth vale o mesmo que estar logado.
.mcp-sessao.json

# s28/s29/s30: o suplemento de Elferink 2010 (1,2 MB, regeneravel pela API do
# Europe PMC) e as copias de proteina que o s29 grava para o miniprot.
runs/atavismo/recombinacao/*.XLS
runs/atavismo/lesoes/q_*.faa

# s31-s34: o que e regeneravel e pesado. Ficam TSV, JSON, os alinhamentos
# multiplos do nivel 4 e os modelos de proteina do ODAPH.
runs/atavismo/odam_odaph/db/
runs/atavismo/odam_odaph/aln/
runs/atavismo/odam_odaph/*.fna
runs/atavismo/odam_odaph/sprot_humano.faa
runs/atavismo/nivel4/*_consulta_*.fna
# AMBN em nucleotideo nao serviu (intron com repeticao espalha os hits): 7,4 MB sem uso
runs/atavismo/nivel4/AMBN_trechos.fna

# dependências do gerador do artigo (scripts/rapinantes/artigo/package.json)
node_modules/

# VCC 2026: os artefatos pesados se regeneram pela cadeia em scripts/vcc/
# (ctrl_bulk -> eixo_18262 -> transfer_fit -> varredura_k -> gerar_submissao) e
# vao para o backup do Drive. A submissao sao 16 GB de h5ad + 3,2 GB de .vcc.
runs/vcc/**/*.h5ad
runs/vcc/**/*.vcc
runs/vcc/**/*.npz
runs/vcc/**/*.npy
