}

manifest {
   description = 'Locos nao alinhados ate arvore de ML, concordancia e arvore de especies, com IQ-TREE 3'
   mainScript = 'main.nf'
   name = 'bio-stack/filogenia'
   nextflowVersion = '!>=25.10.0'
   version = '1.0.0'
}

outputFormat = 'text'

params {
   alinhador = 'famsa'
   alrt = '0'
   concatenar = 'false'
   cpus_concatenado = '8'
   input = '/mnt/c/Users/Manec/bio-stack/data/proc/rapinantes/filogenomica/locos_aa'
   limpeza = 'clipkit'
   nome_taxon = 'primeiro'
   outdir = '/mnt/c/Users/Manec/bio-stack/runs/filogenia/20261018-112050-rapinantes_AA_famsa_clipkit'
   outgroup = 'Gallus_gallus'
   seed = '12345'
   tipo_seq = 'AA'
   ufboot = '0'
}

