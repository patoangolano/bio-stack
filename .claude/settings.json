{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NVIDIA_NIM_MODE": "hosted",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUNBUFFERED": "1",
    "MPLBACKEND": "Agg",
    "NXF_ANSI_LOG": "false",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "permissions": {
    "allow": [
      "Read(//**)",
      "Bash(nvidia-smi*)",
      "Bash(python -c*)",
      "Bash(python -m pytest*)",
      "Bash(uv run*)",
      "Bash(uv pip list*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(basedpyright*)",
      "Bash(samtools view*)",
      "Bash(samtools flagstat*)",
      "Bash(samtools idxstats*)",
      "Bash(bcftools stats*)",
      "Bash(bcftools view -h*)",
      "Bash(seqkit stats*)",
      "Bash(seqkit fx2tab*)",
      "Bash(fastqc --version*)",
      "Bash(multiqc --version*)",
      "Bash(nextflow -version*)",
      "Bash(nextflow info*)",
      "Bash(nextflow lint*)",
      "Bash(nf-core --version*)",
      "Bash(nf-core pipelines list*)",
      "Bash(nf-core pipelines lint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "mcp__nvidia-bio__nim_config",
      "mcp__nvidia-bio__nim_list_models",
      "mcp__nvidia-bio__nim_probe_endpoints",
      "mcp__gget",
      "mcp__biocontext",
      "mcp__biomcp",
      "Bash(uvx tooluniverse*)",
      "Bash(git init*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(python tests/*)",
      "mcp__tooluniverse",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"samtools *\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"bcftools *\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"bedtools *\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"seqkit *\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nextflow -version*\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nextflow info*\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nf-core --version*\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nf-core pipelines list*\")",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nf-core pipelines lint*\")",
      "Bash(wsl -l -v*)"
    ],
    "ask": [
      "Bash(nextflow run*)",
      "Bash(docker run*)",
      "Bash(uv pip install*)",
      "Bash(pip install*)",
      "mcp__nvidia-bio__fold_protein",
      "mcp__nvidia-bio__cofold_complex",
      "mcp__nvidia-bio__dock_ligand",
      "mcp__nvidia-bio__msa_search",
      "mcp__nvidia-bio__evo2_score",
      "mcp__nvidia-bio__nim_invoke",
      "mcp__nvidia-bio__design_backbone",
      "mcp__nvidia-bio__design_sequence",
      "mcp__nvidia-bio__generate_molecules",
      "mcp__nvidia-bio__generate_from_fragment",
      "Bash(wsl -d Ubuntu-24.04 -- bash -lc \"nextflow run*\")",
      "Bash(wsl -d Ubuntu-24.04 -u root*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_mark.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_data.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_gate.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/provenance.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/provenance.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_mark.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_mark.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "bio-stack": {
      "source": {
        "source": "directory",
        "path": "C:/Users/Manec/bio-stack/.claude/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "bio-lsp@bio-stack": true
  }
}
