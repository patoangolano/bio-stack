stName":"Teeling","firstName":"Emma","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-3309-1346"}},{"fullName":"Turner-Maier J","lastName":"Turner-Maier","firstName":"Jason","initials":"J"},{"fullName":"Valenzuela A","lastName":"Valenzuela","firstName":"Alejandro","initials":"A"},{"fullName":"Wagner F","lastName":"Wagner","firstName":"Franziska","initials":"F"},{"fullName":"Wallerman O","lastName":"Wallerman","firstName":"Ola","initials":"O"},{"fullName":"Wang C","lastName":"Wang","firstName":"Chao","initials":"C"},{"fullName":"Wang J","lastName":"Wang","firstName":"Juehan","initials":"J"},{"fullName":"Weng Z","lastName":"Weng","firstName":"Zhiping","initials":"Z"},{"fullName":"Wilder AP","lastName":"Wilder","firstName":"Aryn P","initials":"AP"},{"fullName":"Wirthlin ME","lastName":"Wirthlin","firstName":"Morgan E","initials":"ME"},{"fullName":"Xue JR","lastName":"Xue","firstName":"James R","initials":"JR"},{"fullName":"Zhang X","lastName":"Zhang","firstName":"Xiaomeng","initials":"X"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8338-0253"},{"type":"ORCID","value":"0000-0002-0430-0989"},{"type":"ORCID","value":"0000-0002-0637-7349"},{"type":"ORCID","value":"0000-0002-0850-230X"},{"type":"ORCID","value":"0000-0002-3309-1346"},{"type":"ORCID","value":"0000-0002-3447-9801"},{"type":"ORCID","value":"0000-0002-3539-2513"},{"type":"ORCID","value":"0000-0002-3790-2185"},{"type":"ORCID","value":"0000-0002-4343-3776"},{"type":"ORCID","value":"0000-0002-5082-1929"},{"type":"ORCID","value":"0000-0002-5775-1767"},{"type":"ORCID","value":"0000-0002-6769-7223"},{"type":"ORCID","value":"0000-0002-8723-7902"},{"type":"ORCID","value":"0000-0002-9394-4275"},{"type":"ORCID","value":"0000-0003-1541-8365"},{"type":"ORCID","value":"0000-0003-1912-9667"},{"type":"ORCID","value":"0000-0003-2162-8246"},{"type":"ORCID","value":"0000-0003-3024-1449"},{"type":"ORCID","value":"0000-0003-3088-345X"},{"type":"ORCID","value":"0000-0003-4086-4105"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6643","volume":"380","journalIssueId":3552760,"dateOfPublication":"2023 Apr","monthOfPublication":4,"yearOfPublication":2023,"journal":{"medlineAbbreviation":"Science","title":"Science (New York, N.Y.)","essn":"1095-9203","issn":"0036-8075","nlmid":"0404511","isoabbreviation":"Science"},"printPublicationDate":"2023-04-01"},"pubYear":"2023","pageInfo":"eabn3107","abstractText":"Annotating coding genes and inferring orthologs are two classical challenges in genomics and evolutionary biology that have traditionally been approached separately, limiting scalability. We present TOGA (Tool to infer Orthologs from Genome Alignments), a method that integrates structural gene annotation and orthology inference. TOGA implements a different paradigm to infer orthologous loci, improves ortholog detection and annotation of conserved genes compared with state-of-the-art methods, and handles even highly fragmented assemblies. TOGA scales to hundreds of genomes, which we demonstrate by applying it to 488 placental mammal and 501 bird assemblies, creating the largest comparative gene resources so far. Additionally, TOGA detects gene losses, enables selection screens, and automatically provides a superior measure of mammalian genome quality. TOGA is a powerful and scalable method to annotate and compare genes in the genomic era.","affiliation":"Max Planck Institute of Molecular Cell Biology and Genetics, 01307 Dresden, Germany.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"R01 HG008742","orderIn":0},{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"R01 HG010485","orderIn":0},{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"U24 HG007234","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"}