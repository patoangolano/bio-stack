// Configuracao extra do braco de filogenomica dos rapinantes (passada com -c).
//
// Outra analise pesada divide o WSL (20 nucleos, 15 GB) com esta: o executor
// local fica limitado a 10 CPUs e 13 GB, e os pedidos de memoria descem para o
// que as tarefas usam de fato (arvore de gene AA com 57 taxons: < 100 MB).
// Sem isso, a supermatriz (12 GB pedidos) deixaria uma arvore de gene por vez.
// O IQ-TREE recebe a memoria como -mem e entra no modo de economia se precisar.
// Tempos folgados: no executor local estourar o `time` derruba a execucao
// inteira (base.config), e a supermatriz AA em 8 threads passa de 24 h facil.

executor {
    name   = 'local'
    cpus   = 10
    memory = '13 GB'
}

process {
    resourceLimits = [cpus: 10, memory: 12.GB, time: 168.h]

    withName: 'IQTREE_GENES' {
        memory = { 1.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withName: 'IQTREE_CONCAT' {
        memory = 9.GB
        time   = 144.h
    }
    withName: 'IQTREE_CONCORDANCIA' {
        memory = 6.GB
        time   = 96.h
    }
}
