// Configuracao extra para uma segunda execucao em paralelo (passada com -c).
//
// Enquanto a supermatriz AA ocupa 8 threads, sobram 2 das 10 CPUs deste braco
// (outra analise pesada divide o WSL). Esta execucao usa essas 2: so arvores de
// gene (rodar com --concatenar false); a supermatriz entra depois, com -resume e
// o limite_10cpus.config. Memoria baixa: a supermatriz AA ja reserva 9 GB.

executor {
    name   = 'local'
    cpus   = 2
    memory = '3 GB'
}

process {
    resourceLimits = [cpus: 2, memory: 3.GB, time: 168.h]

    // Sem MAFFT aqui: com 2 CPUs o --thread do MAFFT mudaria, o hash da tarefa
    // tambem, e o -resume nao reaproveitaria o alinhamento da execucao principal.
    withName: 'FAMSA_ALIGN' {
        cpus = 2
    }
    withName: 'IQTREE_GENES' {
        memory = { 1.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withName: 'ASTER_WASTRAL' {
        cpus = 2
    }
}
