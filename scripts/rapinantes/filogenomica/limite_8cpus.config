// Configuracao extra para a retomada da execucao FAMSA (passada com -c).
//
// A primeira parte rodou com limite_2cpus.config enquanto outra analise pesada
// dividia o WSL. Em 2026-10-18 ~12:40 (Brasilia) a carga era 10 em 20 nucleos:
// so a supermatriz AA (8 threads) e esta execucao (2). Sobe so a concorrencia
// do executor de 2 para 8 tarefas; o resourceLimits por tarefa fica identico ao
// do limite_2cpus.config. CLIPKIT e FAMSA_ALIGN usam ${task.cpus} no comando, e
// a fila de rotulos pede ate 4 CPUs: com um teto por tarefa maior o hash mudaria
// e o -resume refaria os 300 alinhamentos e as 138 limpezas ja prontos.

executor {
    name   = 'local'
    cpus   = 8
    memory = '8 GB'
}

process {
    resourceLimits = [cpus: 2, memory: 3.GB, time: 168.h]

    withName: 'FAMSA_ALIGN' {
        cpus = 2
    }
    withName: 'IQTREE_GENES' {
        memory = { 1.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withName: 'ASTER_WASTRAL' {
        cpus = 2
    }
}
