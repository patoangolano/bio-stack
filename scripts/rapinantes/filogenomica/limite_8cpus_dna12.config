// Configuracao extra para a fase 2 da execucao DNA 1+2 (supermatriz), passada com -c
// numa retomada (-resume) da execucao 20261018-084205-rapinantes_DNA12.
//
// A fase 1 (arvores de genes, --concatenar false) rodou com limite_2cpus.config.
// Desde 2026-10-18 ~12:40 a outra analise pesada nao divide mais o WSL, e o
// coordenador subiu o envelope deste braco para 16 CPUs (supermatriz AA, 8, mais
// uma segunda execucao, 8). Esta fase ocupa o lugar da execucao FAMSA quando ela
// termina: 8 CPUs, so para a supermatriz DNA 1+2 e a concordancia. As arvores de
// genes vem do cache: IQTREE_GENES continua com 1 CPU (modules.config), o comando
// e o mesmo e o hash nao muda.

executor {
    name   = 'local'
    cpus   = 8
    memory = '10 GB'
}

process {
    resourceLimits = [cpus: 8, memory: 9.GB, time: 168.h]

    withName: 'IQTREE_GENES' {
        memory = { 1.GB * task.attempt }
        time   = { 48.h * task.attempt }
    }
    withName: 'ASTER_WASTRAL' {
        cpus = 2
    }
    withName: 'IQTREE_CONCAT' {
        memory = 8.GB
        time   = 144.h
    }
    withName: 'IQTREE_CONCORDANCIA' {
        memory = 6.GB
        time   = 96.h
    }
}
